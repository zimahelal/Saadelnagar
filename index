<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صدقة جارية - سعد محمد سعد النجار</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #f0fdfa; }
        .amiri { font-family: 'Amiri', serif; }
        .bg-pattern { background-image: url('https://www.transparenttextures.com/patterns/arabesque.png'); }
    </style>
</head>
<body class="text-gray-800 antialiased min-h-screen flex flex-col">
    
    <!-- الهيدر (رأس الصفحة) -->
    <header class="bg-teal-800 text-white py-16 text-center shadow-xl relative bg-pattern border-b-4 border-yellow-500">
        <div class="relative z-10 px-4">
            <h1 class="text-3xl md:text-4xl font-bold mb-4 amiri text-teal-100">صدقة جارية</h1>
            <p class="text-xl md:text-2xl mt-2 text-teal-50">على روح المغفور له بإذن الله</p>
            <h2 class="text-4xl md:text-6xl font-bold text-yellow-400 mt-6 amiri leading-tight">سعد محمد سعد النجار</h2>
            <p class="mt-8 text-lg md:text-xl font-medium bg-teal-900 bg-opacity-50 inline-block px-6 py-2 rounded-full border border-teal-700">
                اللهم اغفر له وارحمه وعافه واعف عنه وأكرم نزله ووسع مدخله
            </p>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="container mx-auto px-4 py-12 flex-grow">
        
        <!-- السبحة الإلكترونية -->
        <section class="max-w-md mx-auto bg-white rounded-2xl shadow-lg overflow-hidden p-8 text-center mb-12 border border-gray-100 relative">
            <div class="absolute top-0 right-0 w-full h-2 bg-teal-600"></div>
            <h3 class="text-2xl font-bold text-teal-800 mb-6 amiri">السبحة الإلكترونية</h3>
            
            <div class="text-2xl mb-6 text-teal-700 font-bold transition-all duration-300" id="zekr-text">سبحان الله</div>
            
            <div class="bg-gray-50 border-2 border-gray-200 rounded-xl py-6 mb-8">
                <div class="text-6xl font-bold text-gray-800" id="counter">0</div>
            </div>
            
            <button onclick="incrementCounter()" class="bg-teal-600 text-white w-32 h-32 rounded-full text-3xl font-bold shadow-xl hover:bg-teal-700 hover:shadow-2xl transition duration-200 active:scale-90 border-4 border-teal-100 focus:outline-none">
                تسبيح
            </button>
            
            <div class="mt-8">
                <button onclick="resetCounter()" class="text-gray-400 hover:text-red-500 transition text-sm flex items-center justify-center mx-auto gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                    تصفير العداد
                </button>
            </div>
        </section>

        <!-- روابط هامة -->
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            <a href="https://quran.com/ar" target="_blank" class="group flex flex-col items-center justify-center bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-teal-500">
                <div class="bg-teal-100 p-4 rounded-full mb-4 group-hover:bg-teal-600 transition-colors duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-teal-700 group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-2 amiri group-hover:text-teal-700">القرآن الكريم</h3>
                <p class="text-gray-500 text-sm">تلاوة واستماع</p>
            </a>
            
            <a href="https://hisnmuslim.com/" target="_blank" class="group flex flex-col items-center justify-center bg-white p-8 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-teal-500">
                <div class="bg-teal-100 p-4 rounded-full mb-4 group-hover:bg-teal-600 transition-colors duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-teal-700 group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002" /></svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-2 amiri group-hover:text-teal-700">حصن المسلم</h3>
                <p class="text-gray-500 text-sm">أذكار وأدعية</p>
            </a>
        </div>
        
        <div class="text-center mt-12">
            <p class="text-gray-600 font-medium">رجاءً قراءة الفاتحة والدعاء له بالرحمة والمغفرة</p>
        </div>
    </main>

    <!-- الفوتر (أسفل الصفحة) -->
    <footer class="bg-gray-800 text-gray-400 py-6 text-center text-sm">
        <p>صدقة جارية - نسألكم الدعاء</p>
    </footer>

    <!-- سكربت السبحة -->
    <script>
        let count = 0;
        const azkar = [
            "سبحان الله", 
            "الحمد لله", 
            "لا إله إلا الله", 
            "الله أكبر", 
            "لا حول ولا قوة إلا بالله",
            "أستغفر الله",
            "اللهم صلِ على محمد"
        ];
        let currentZekr = 0;

        function incrementCounter() {
            count++;
            document.getElementById('counter').innerText = count;
            
            // تغيير الذكر كل 33 تسبيحة
            if(count % 33 === 0) {
                currentZekr = (currentZekr + 1) % azkar.length;
                document.getElementById('zekr-text').style.opacity = 0;
                
                setTimeout(() => {
                    document.getElementById('zekr-text').innerText = azkar[currentZekr];
                    document.getElementById('zekr-text').style.opacity = 1;
                }, 200);
            }
        }

        function resetCounter() {
            count = 0;
            currentZekr = 0;
            document.getElementById('counter').innerText = count;
            document.getElementById('zekr-text').innerText = azkar[currentZekr];
        }
    </script>
</body>
</html>
